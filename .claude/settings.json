{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(vp run verify)",
      "Bash(vp run check)",
      "Bash(vp run fix)",
      "Bash(vp run lint)",
      "Bash(vp run lint:fix)",
      "Bash(vp run format)",
      "Bash(vp run format:check)",
      "Bash(vp run typecheck)",
      "Bash(vp run types:worker)",
      "Bash(vp run check:no-js-source)",
      "Bash(vp run test)",
      "Bash(vp run test:unit)",
      "Bash(vp run test:unit:verbose)",
      "Bash(vp run build:*)",
      "Bash(vp test run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)"
    ],
    "deny": [
      "Read(./package-lock.json)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./.generated/**)",
      "Read(./.wrangler/**)",
      "Read(./public/*.js)",
      "Read(./docs/public/**)",
      "Read(./docs/reference/api.md)",
      "Read(./playwright-report/**)",
      "Read(./e2e/test-results/**)"
    ]
  }
}
