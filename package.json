{
  "name": "hifiscout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test",
    "test:e2e": "npm --prefix e2e test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "create-shop": "node scripts/create-shop.mjs"
  },
  "devDependencies": {
    "@cloudflare/playwright": "^1.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "wrangler": "^4.45.0"
  }
}
