{
  "name": "hifiscout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "tsx --test test/*.test.ts",
    "test:e2e": "npm --prefix e2e test",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --no-error-on-unmatched-pattern \"**/*.ts\" \"**/*.mts\" \"**/*.cts\" \"**/*.tsx\"",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern \"**/*.ts\" \"**/*.mts\" \"**/*.cts\" \"**/*.tsx\"",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "create-shop": "tsx scripts/create-shop.ts",
    "docs:api": "npx --yes --package typedoc@0.28.20 --package typedoc-plugin-markdown@4.12.0 --package typescript@6.0.2 typedoc && tsx scripts/docs/publish-api-docs.ts",
    "docs:architecture:check": "npx --yes --package typescript@6.0.2 --package dependency-cruiser@18.1.0 depcruise src --config .dependency-cruiser.json --ts-config tsconfig.json --output-type err",
    "docs:architecture": "tsx scripts/ensure-directories.ts docs/public/generated && npx --yes --package typescript@6.0.2 --package dependency-cruiser@18.1.0 depcruise src --config .dependency-cruiser.json --ts-config tsconfig.json --output-type html --output-to docs/public/generated/dependencies.html",
    "docs:db": "bash scripts/docs/generate-db-docs.sh",
    "docs:generate": "npm run docs:api && npm run docs:architecture && npm run docs:db",
    "docs:build": "npm run docs:generate && npx --yes vitepress@1.6.4 build docs",
    "docs:dev": "npm run docs:generate && npx --yes vitepress@1.6.4 dev docs",
    "docs:preview": "npx --yes vitepress@1.6.4 preview docs",
    "typecheck": "npm run types:worker && tsc --noEmit",
    "types:worker": "tsx scripts/ensure-directories.ts .generated && wrangler types .generated/worker-configuration.d.ts",
    "build": "npm run build:frontend && npm run build:worker && npm run build:lambda",
    "build:frontend": "esbuild frontend/app.ts frontend/catalog-url-state.ts frontend/shop-links.ts --outdir=public --format=iife --target=es2022",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "build:lambda": "tsx scripts/ensure-directories.ts dist/audiounion-lambda && esbuild infra/audiounion-lambda/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/audiounion-lambda/index.mjs",
    "check:no-js-source": "tsx scripts/check-no-first-party-js.ts"
  },
  "devDependencies": {
    "@cloudflare/playwright": "^1.3.0",
    "@playwright/test": "^1.62.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "wrangler": "^4.45.0"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "v${version}",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "security",
              "release": "patch"
            },
            {
              "type": "perf",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failComment": false
        }
      ]
    ]
  }
}
