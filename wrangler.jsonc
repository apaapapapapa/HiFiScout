{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hifiscout",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "PublicSearchCache": { "type": "worker", "cache": { "enabled": true } },
    "CrawlScheduler": { "type": "durable-object", "storage": "sqlite" },
    "AdminJobs": { "type": "durable-object", "storage": "sqlite" },
    "YahooAuctions": { "type": "durable-object", "storage": "sqlite" },
    "NotificationHub": { "type": "durable-object", "storage": "sqlite" }
  },
  "durable_objects": {
    "bindings": [{ "name": "CRAWL_SCHEDULER", "class_name": "CrawlScheduler" }, { "name": "ADMIN_JOBS", "class_name": "AdminJobs" }, { "name": "YAHOO_AUCTIONS", "class_name": "YahooAuctions" }, { "name": "NOTIFICATIONS", "class_name": "NotificationHub" }]
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "browser": { "binding": "BROWSER" },
  "ai": { "binding": "AI" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/", "/auctions"] },
  "triggers": { "crons": ["*/5 * * * *", "*/10 2-13 * * *", "1,31 0-13,23 * * *", "30 12 * * *"] },
  "queues": {
    "producers": [
      { "binding": "KNOWLEDGE_CATALOG_QUEUE", "queue": "hifiscout-knowledge-verification" },
      { "binding": "PRODUCT_AUDIT_EXPORT_QUEUE", "queue": "hifiscout-product-audit-export" },
      { "binding": "AI_CATALOG_QUEUE", "queue": "hifiscout-ai-catalog" }
    ],
    "consumers": [
      { "queue": "hifiscout-knowledge-verification", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 8, "retry_delay": 300, "dead_letter_queue": "hifiscout-knowledge-verification-dlq", "max_concurrency": 1 },
      { "queue": "hifiscout-knowledge-verification-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3, "retry_delay": 300, "max_concurrency": 1 },
      { "queue": "hifiscout-product-audit-export", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 10, "retry_delay": 30, "dead_letter_queue": "hifiscout-product-audit-export-dlq", "max_concurrency": 1 },
      { "queue": "hifiscout-product-audit-export-dlq", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3, "retry_delay": 30, "max_concurrency": 1 },
      { "queue": "hifiscout-ai-catalog", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 2, "retry_delay": 300, "dead_letter_queue": "hifiscout-ai-catalog-dlq", "max_concurrency": 1 },
      { "queue": "hifiscout-ai-catalog-dlq", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 2, "retry_delay": 300, "max_concurrency": 1 }
    ]
  },
  "ratelimits": [{ "name": "API_RATE_LIMITER", "namespace_id": "541721", "simple": { "limit": 120, "period": 60 } }],
  "vars": {
    "NOTIFICATIONS_ENABLED": "true",
    "YAHOO_AUCTIONS_COLLECT_ENABLED": "false",
    "YAHOO_AUCTIONS_SEARCH_ENABLED": "false",
    "YAHOO_AUCTIONS_DISPLAY_ENABLED": "false",
    "AI_CATALOG_ENABLED": "true",
    "AI_CATALOG_EVALUATION_POLICY": "{\"model\":\"@cf/qwen/qwen3-30b-a3b-fp8\",\"kind\":\"catalog_model_lead\",\"promptVersion\":3,\"schemaVersion\":2,\"maxJobsPerDay\":25,\"maxAttempts\":2,\"maxInputTokens\":2000,\"maxRequestBytes\":1744,\"maxOutputTokens\":300,\"maxResponseBytes\":4096,\"maxCandidates\":5,\"maxNeuronsPerDay\":1000,\"inputNeuronsPerMillion\":4625,\"outputNeuronsPerMillion\":30475,\"retentionDays\":180}",
    "AUDIOUNION_ENABLED": "true",
    "IPPINKAN_ENABLED": "true",
    "FUJIYA_AVIC_ENABLED": "true",
    "HIFIDO_ENABLED": "true",
    "FORMUSIC_ENABLED": "true",
    "U_AUDIO_ENABLED": "true",
    "SHIMAMUSEN_ENABLED": "true",
    "DYNAMIC_AUDIO_ENABLED": "true",
    "AFROAUDIO_ENABLED": "true",
    "OSAKAYA_ENABLED": "true",
    "SOUNDPIT_ENABLED": "true",
    "SOUND_SUPPORT_ENABLED": "true",
    "AVAC_ENABLED": "true",
    "TEREON_ENABLED": "true",
    "AUDIO_SPACE_CORE_ENABLED": "true",
    "REWIRE_ENABLED": "true",
    "HOME_SHOKAI_ENABLED": "true",
    "E_EARPHONE_ENABLED": "false",
    "AUDIOUNION_REQUEST_DELAY_MS": "10000",
    "AVAC_REQUEST_DELAY_MS": "1500",
    "AUDIOUNION_INVENTORY_RECHECK_ENABLED": "true",
    "HIFIDO_INVENTORY_RECHECK_ENABLED": "true",
    "FUJIYA_AVIC_INVENTORY_RECHECK_ENABLED": "true",
    "HIFIDO_MAX_PAGES": "3",
    "HIFIDO_RECHECK_MAX_PAGE": "120",
    "CRAWL_REQUEST_DELAY_MS": "1200",
    "CRAWL_MAX_PAGES_PER_SHOP": "40",
    "CRAWL_MIN_ITEM_RATIO": "0.5",
    "CRAWL_MIN_ITEM_BASELINE": "20",
    "CRAWL_DISPATCH_LEASE_MINUTES": "30",
    "CRAWL_COLLECTION_BUDGET_MS": "240000",
    "CRAWL_INVOCATION_BUDGET_MS": "600000",
    "CRAWL_TERMINAL_BUDGET_MS": "15000",
    "PRODUCT_TOUCH_INTERVAL_MINUTES": "1440",
    "SYNC_HEALTH_WARNING_FACTOR": "2",
    "SYNC_HEALTH_CRITICAL_FACTOR": "6",
    "CRAWL_RUN_RETENTION_DAYS": "30",
    "PRICE_HISTORY_RETENTION_DAYS": "1095",
    "INACTIVE_PRODUCT_RETENTION_DAYS": "365",
    "RETENTION_DELETE_BATCH_SIZE": "500",
    "KNOWLEDGE_CATALOG_REVIEW_INTERVAL_DAYS": "30",
    "KNOWLEDGE_CATALOG_DAILY_VERIFY_MAX_CANDIDATES": "200",
    "KNOWLEDGE_CATALOG_QUEUE_WAKE_MAX_JOBS": "8",
    "KNOWLEDGE_CATALOG_QUEUE_WAKE_WALL_BUDGET_MS": "25000",
    "KNOWLEDGE_CATALOG_SOURCE_TIMEOUT_MS": "10000",
    "AUDIOUNION_ENTRY_URL": "https://www.audiounion.jp/st/new_arrival_used.html",
    "CRAWLER_USER_AGENT": "HiFiScoutBot/0.1 (+https://github.com/apaapapapapa/HiFiScout)"
  },
  "r2_buckets": [{ "binding": "EVIDENCE_BUCKET", "bucket_name": "hifiscout-evidence" }, { "binding": "OPS_BUCKET", "bucket_name": "hifiscout-d1-observations" }],
  "d1_databases": [{ "binding": "DB" }]
}
