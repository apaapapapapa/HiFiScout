{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hifiscout",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "browser": { "binding": "BROWSER" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "triggers": { "crons": ["*/5 * * * *", "1 * * * *", "30 * * * *", "17 18 * * *", "23 3 1 * *"] },
  "queues": {
    "producers": [
      { "binding": "CRAWL_QUEUE", "queue": "hifiscout-crawl" },
      { "binding": "KNOWLEDGE_CATALOG_QUEUE", "queue": "hifiscout-knowledge-verification" }
    ],
    "consumers": [
      { "queue": "hifiscout-crawl", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3, "retry_delay": 60, "dead_letter_queue": "hifiscout-crawl-dlq", "max_concurrency": 1 },
      { "queue": "hifiscout-knowledge-verification", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 100, "retry_delay": 300, "dead_letter_queue": "hifiscout-knowledge-verification-dlq", "max_concurrency": 4 },
      { "queue": "hifiscout-knowledge-verification-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3, "retry_delay": 300, "max_concurrency": 1 }
    ]
  },
  "ratelimits": [{ "name": "API_RATE_LIMITER", "namespace_id": "541721", "simple": { "limit": 120, "period": 60 } }],
  "vars": {
    "AUDIOUNION_ENABLED": "true",
    "IPPINKAN_ENABLED": "true",
    "FUJIYA_AVIC_ENABLED": "true",
    "HIFIDO_ENABLED": "true",
    "FORMUSIC_ENABLED": "true",
    "UAUDIO_ENABLED": "true",
    "SHIMAMUSEN_ENABLED": "true",
    "AUDIOUNION_INTERVAL_MINUTES": "60",
    "IPPINKAN_INTERVAL_MINUTES": "60",
    "FUJIYA_AVIC_INTERVAL_MINUTES": "60",
    "HIFIDO_INTERVAL_MINUTES": "30",
    "FORMUSIC_INTERVAL_MINUTES": "60",
    "UAUDIO_INTERVAL_MINUTES": "60",
    "SHIMAMUSEN_INTERVAL_MINUTES": "60",
    "AUDIOUNION_REQUEST_DELAY_MS": "10000",
    "IPPINKAN_REQUEST_DELAY_MS": "1200",
    "FUJIYA_AVIC_REQUEST_DELAY_MS": "1200",
    "HIFIDO_REQUEST_DELAY_MS": "1200",
    "FORMUSIC_REQUEST_DELAY_MS": "1200",
    "UAUDIO_REQUEST_DELAY_MS": "1200",
    "SHIMAMUSEN_REQUEST_DELAY_MS": "1200",
    "AUDIOUNION_INVENTORY_RECHECK_ENABLED": "true",
    "AUDIOUNION_INVENTORY_RECHECK_MIN_AGE_HOURS": "24",
    "AUDIOUNION_INVENTORY_RECHECK_INTERVAL_HOURS": "24",
    "AUDIOUNION_INVENTORY_RECHECK_FAILURE_THRESHOLD": "2",
    "FUJIYA_AVIC_MAX_PAGES": "50",
    "HIFIDO_MAX_PAGES": "3",
    "UAUDIO_MAX_PAGES": "50",
    "SHIMAMUSEN_MAX_PAGES": "20",
    "HIFIDO_RECHECK_MAX_PAGE": "120",
    "CRAWL_REQUEST_DELAY_MS": "1200",
    "CRAWL_MAX_PAGES_PER_SHOP": "40",
    "CRAWL_MIN_ITEM_RATIO": "0.5",
    "CRAWL_MIN_ITEM_BASELINE": "20",
    "CRAWL_DISPATCH_LEASE_MINUTES": "15",
    "PRODUCT_TOUCH_INTERVAL_MINUTES": "1440",
    "SYNC_HEALTH_WARNING_FACTOR": "2",
    "SYNC_HEALTH_CRITICAL_FACTOR": "6",
    "CRAWL_RUN_RETENTION_DAYS": "30",
    "PRICE_HISTORY_RETENTION_DAYS": "1095",
    "INACTIVE_PRODUCT_RETENTION_DAYS": "365",
    "RETENTION_DELETE_BATCH_SIZE": "500",
    "KNOWLEDGE_CATALOG_REVIEW_INTERVAL_DAYS": "30",
    "KNOWLEDGE_CATALOG_DAILY_VERIFY_MAX_CANDIDATES": "200",
    "KNOWLEDGE_CATALOG_VERIFY_MAX_CANDIDATES": "200",
    "KNOWLEDGE_CATALOG_VERIFY_MAX_DUE_PRODUCTS": "25",
    "KNOWLEDGE_CATALOG_QUEUE_JOB_LEASE_SECONDS": "900",
    "KNOWLEDGE_CATALOG_QUEUE_DOMAIN_LEASE_SECONDS": "900",
    "KNOWLEDGE_CATALOG_QUEUE_DOMAIN_RETRY_SECONDS": "60",
    "KNOWLEDGE_CATALOG_QUEUE_TRANSIENT_MAX_ATTEMPTS": "4",
    "KNOWLEDGE_CATALOG_QUEUE_FINALIZE_RETRY_SECONDS": "300",
    "KNOWLEDGE_CATALOG_SOURCE_REQUEST_DELAY_MS": "500",
    "KNOWLEDGE_CATALOG_SOURCE_TIMEOUT_MS": "10000",
    "KNOWLEDGE_CATALOG_SOURCE_MAX_RESPONSE_BYTES": "1500000",
    "KNOWLEDGE_CATALOG_SOURCE_MAX_SITEMAPS": "6",
    "KNOWLEDGE_CATALOG_SOURCE_MAX_URLS": "5000",
    "KNOWLEDGE_CATALOG_SOURCE_MAX_PRODUCT_PAGES": "4",
    "EVIDENCE_MAX_BYTES": "1500000",
    "EVIDENCE_DAILY_MAX_OBJECTS": "500",
    "EVIDENCE_DAILY_MAX_BYTES": "200000000",
    "EVIDENCE_SHOP_DAILY_MAX_OBJECTS": "100",
    "EVIDENCE_BURST_WINDOW_MINUTES": "15",
    "EVIDENCE_BURST_MAX_OBJECTS": "20",
    "EVIDENCE_BURST_SAMPLE_RATE": "10",
    "EVIDENCE_STORAGE_WARNING_BYTES": "8000000000",
    "AUDIOUNION_ENTRY_URL": "https://www.audiounion.jp/st/new_arrival_used.html",
    "CRAWLER_USER_AGENT": "HiFiScoutBot/0.1 (+https://github.com/apaapapapa/HiFiScout)"
  },
  "r2_buckets": [{ "binding": "EVIDENCE_BUCKET", "bucket_name": "hifiscout-evidence" }],
  "d1_databases": [{ "binding": "DB" }]
}
