# Only required for manually forcing a crawl through POST /api/admin/crawl?shop=ippinkan
ADMIN_TOKEN=change-me

# Shared Tokyo Lambda relay for shops that need a Japan-origin request.
# Keep the real values out of source control.
CRAWL_RELAY_URL=https://example.lambda-url.ap-northeast-1.on.aws/
CRAWL_RELAY_TOKEN=change-me-with-a-long-random-token
