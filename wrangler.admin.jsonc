{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hifiscout-admin",
  "main": "src/admin/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./admin-public",
    "binding": "ADMIN_ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "CATALOG_ADMIN",
      "service": "hifiscout",
      "entrypoint": "CatalogAdminService"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://invalid.cloudflareaccess.com",
    "ACCESS_AUD": "unconfigured"
  }
}
