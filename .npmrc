# Keep npm's own chatter out of command output. Every `npm run` otherwise prefixes each script
# with `npm notice run ...` lines that carry no information but are read back as context tokens
# by AI coding agents. Warnings and errors are still shown, and exit codes are unaffected.
loglevel=warn
fund=false
# Dependency security has its own explicit CI job; avoid repeating the registry audit during installs.
audit=false
