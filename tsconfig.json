{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "infra/**/*.ts",
    "frontend/**/*.ts",
    "docs/**/*.ts",
    "docs/**/*.mts",
    ".generated/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "build", "docs/.vitepress/dist"]
}
